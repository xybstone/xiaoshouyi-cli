{
  "name": "xiaoshouyi-cli",
  "version": "0.4.1",
  "description": "销售易 CRM 命令行工具 — 为 AI Agent 设计的 CRM 操作接口",
  "type": "module",
  "bin": {
    "xsy": "./dist/cli.js",
    "xsy-mcp": "./dist/mcp-server.js",
    "xsy-mcp-http": "./dist/mcp-http-server.js"
  },
  "files": [
    "dist/",
    "skill/",
    "scripts/with-neocrm-session.mjs",
    "scripts/ticket-live-acceptance.mjs"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "mcp:http": "node dist/mcp-http-server.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/contract",
    "test:integration": "vitest run tests/integration/tickets",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:smoke": "npm run build && node scripts/ticket-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build && node scripts/ticket-smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "xiaoshouyi",
    "crm",
    "cli",
    "ai-agent"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axios": "^1.16.0",
    "commander": "^14.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
